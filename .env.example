# ============================================================================
# PEERNEST - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# Authentication & Session Security
JWT_SECRET=your_super_secret_jwt_hmac_sha256_key_at_least_32_characters_long

# Campus Institutional Email Restriction
INSTITUTIONAL_EMAIL_DOMAIN=vitstudent.ac.in

# Database Configuration (PostgreSQL / Supabase)
# For embedded zero-dependency mode, node:sqlite is used automatically if DB_PATH is set or by default.
# For remote Supabase production deployment, configure the following:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-SUPABASE-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_secret_key

# Payment Gateway (Razorpay India)
# When left empty, PeerNest runs in fully functional Test/Demo Mode with simulated signatures and payouts.
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here
RAZORPAY_KEY_SECRET=your_actual_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Maps and Routing API (Optional: Fallback Haversine + VIT Campus Network engine is built-in)
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_public_or_secret_token_here

# Email Notification Service (Optional: OTPs are logged/returned transparently in test mode)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_resend_api_key_here
EMAIL_FROM=PeerNest VIT <notifications@peernest.campus>
